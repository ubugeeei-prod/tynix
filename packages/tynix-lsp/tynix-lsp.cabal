cabal-version:      3.8
name:               tynix-lsp
version:            2.0.0.0
build-type:         Simple
license:            MIT
license-file:       LICENSE
author:             tynix contributors
maintainer:         tynix contributors
homepage:           https://github.com/ubugeeei/tynix
bug-reports:        https://github.com/ubugeeei/tynix/issues
category:           Language
synopsis:           Minimal LSP server for tynix

library
  exposed-modules:
      AnalysisCache
    , Server
    , ServerProtocol
    , ServerUri
    , Session
    , SessionDiagnostics
    , SessionDocuments
    , SessionFolding
    , SessionInlayHints
    , SessionLinks
    , SessionCompletion
    , SessionHover
    , SessionNavigation
    , SessionPublish
    , SessionReferences
    , SessionResolve
    , SessionScan
    , SessionSemanticTokens
    , SessionSymbols
    , SessionText
    , SessionTypes
    , SessionWorkspace
  other-modules:
      SessionRequest
  hs-source-dirs: src
  build-depends:
      aeson
    , base >=4.19 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , tynix-core
  default-language: GHC2021

executable tynix-lsp
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options: -threaded -rtsopts
  other-modules:
      Paths_tynix_lsp
  build-depends:
      aeson
    , base >=4.19 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , tynix-lsp
    , tynix-core
  default-language: GHC2021

test-suite tynix-lsp-spec
  type: exitcode-stdio-1.0
  main-is: Server.spec.hs
  hs-source-dirs: src
  other-modules:
      Server
    , ServerProtocol
    , ServerUri
  build-depends:
      aeson
    , base >=4.19 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , hspec
    , text
    , tynix-core
    , tynix-lsp
    , unix
  default-language: GHC2021

